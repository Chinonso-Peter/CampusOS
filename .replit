modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm run build"]
start = ["node", "artifacts/api-server/dist/index.mjs"]

[deployment.postBuild]
args = ["echo", "noop"]

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
